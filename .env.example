# Copy to .env. Generate separate random secrets; examples contain no credentials.
# Host ports published on 127.0.0.1 by Docker Compose.
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=54329
WAHA_HOST_PORT=3001
# If using local development without Compose, update the URLs below to match changed host ports.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://booking:REPLACE_DB_PASSWORD@127.0.0.1:54329/booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_DB=booking
HEALTH_TOKEN=REPLACE_WITH_RANDOM_32_CHARACTERS
WAHA_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_CHARACTERS
OTP_SECRET=REPLACE_WITH_SEPARATE_RANDOM_32_CHARACTERS
WAHA_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_RANDOM_32_CHARACTERS
WAHA_BASE_URL=http://127.0.0.1:3001
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002
# Required when validating payment; copied into each immutable invoice.
WORKSHOP_NAME=Bengkel Anda
WORKSHOP_ADDRESS=Alamat bengkel
WORKSHOP_PHONE=Nomor telepon bengkel
# Optional absolute directory shared by web and worker. Default: <repo>/storage/invoices.
# INVOICE_STORAGE_PATH=C:/absolute/private/invoices
# Local Windows default is Google Chrome; Linux default is /usr/bin/chromium.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
