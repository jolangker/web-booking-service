{
  "name": "web-booking-service",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.16.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "admin:bootstrap": "pnpm build:packages && pnpm --filter @booking/core admin:bootstrap",
    "admin:reset": "pnpm build:packages && pnpm --filter @booking/core admin:reset",
    "dev": "pnpm build:packages && pnpm --parallel --filter @booking/web --filter @booking/worker dev",
    "dev:web": "pnpm build:packages && pnpm --filter @booking/web dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @booking/worker dev",
    "db:migrate": "pnpm --filter @booking/db build && pnpm --filter @booking/db migrate",
    "db:generate": "pnpm --filter @booking/db generate",
    "build:packages": "pnpm --filter @booking/db --filter @booking/core build",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "5.9.3"
  }
}
