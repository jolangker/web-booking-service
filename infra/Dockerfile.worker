FROM node:24.16.0-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203 AS build
WORKDIR /app
RUN npm install --global pnpm@9.15.9
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build:packages && pnpm --filter @booking/worker build
RUN pnpm --filter @booking/worker deploy --prod /runtime

FROM node:24.16.0-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203
WORKDIR /app
ENV NODE_ENV=production WORKER_HEALTH_HOST=0.0.0.0
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/storage/invoices && chown -R node:node /app/storage
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium PUPPETEER_DISABLE_SANDBOX=true
COPY --from=build --chown=node:node /runtime ./
USER node
EXPOSE 3002
CMD ["node", "dist/index.js"]
